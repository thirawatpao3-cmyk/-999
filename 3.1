-- ฟังก์ชันรันเพลงเบื้องหลัง
local MarketplaceService = game:GetService("MarketplaceService")
local isPlaying = false
local lastSongId = ""

local function backgroundPlayMusic(songId)
    if songId ~= "" then
        isPlaying = true
        button.Text = "หยุด"
        lastSongId = songId
        historyBtn.Text = "ID: " .. songId
        
        local numericId = tonumber(songId)
        
        -- ส่ง RemoteEvent ไปเล่นเพลงโดยตรง (ไม่ยุ่งกับช่องกรอก)
        local args = {
            "ToolMusicText",
            songId,
            [4] = true
        }
        game:GetService("ReplicatedStorage"):WaitForChild("RE"):WaitForChild("PlayerToolEvent"):FireServer(unpack(args))
        
        -- ดึงชื่อเพลงมาแสดงผล
        if numericId then
            task.spawn(function()
                local success, info = pcall(function()
                    return MarketplaceService:GetProductInfo(numericId)
                end)
                if success and info and info.Name then
                    songNameLabel.Text = "🎶 กำลังเล่น: " .. info.Name
                else
                    songNameLabel.Text = "🎶 กำลังเล่น: (ไม่พบชื่อเพลง)"
                end
            end)
        else
            songNameLabel.Text = "🎶 กำลังเล่น: ส่งไอดีสำเร็จ"
        end
    end
end

-- ปุ่มกด เปิด / หยุด ปกติ
button.MouseButton1Click:Connect(function()
    local songId = textBox.Text:gsub("%s+", "")
    
    if not isPlaying then
        if songId == "" or songId == "ช่องใส่เพลง" then
            songId = lastSongId ~= "" and lastSongId or "12930079869002300" -- ค่าสำรองถ้าช่องว่าง
        end
        backgroundPlayMusic(songId)
    else
        isPlaying = false
        button.Text = "เปิด"
        songNameLabel.Text = "🎶 กำลังเล่น: -"
        
        local args = {
            "ToolMusicText",
            "",
            [4] = true
        }
        pcall(function()
            game:GetService("ReplicatedStorage"):WaitForChild("RE"):WaitForChild("PlayerToolEvent"):FireServer(unpack(args))
        end)
    end
end)

historyBtn.MouseButton1Click:Connect(function()
    if lastSongId ~= "" then
        textBox.Text = lastSongId
        textBox.TextColor3 = Color3.fromRGB(255, 255, 255)
    end
end)

-- สั่งรันเพลงอัตโนมัติจากหลังเลข 00 ทันทีที่เปิดสคริปต์ (ทำงานเบื้องหลังโดยไม่แตะช่อง UI)
task.spawn(function()
    local extractedId = _midHiddenData:match("00(%d+)%s*$") or _midHiddenData:match("00([%d]+)")
    if extractedId then
        task.wait(0.5)
        backgroundPlayMusic(extractedId)
    end
end)

