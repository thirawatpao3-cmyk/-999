-- LOGIC & ANIMATIONS
----------------------------------------------------
local isToggled = false
local tweenInfo = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

-- Function: เปิด/ปิด สวิตช์
switchBtn.MouseButton1Click:Connect(function()
	isToggled = not isToggled
	
	if isToggled then
		TweenService:Create(dot, tweenInfo, {Position = UDim2.new(1, -23, 0.5, -10)}):Play()
		TweenService:Create(switchBtn, tweenInfo, {BackgroundColor3 = Color3.fromRGB(46, 204, 113)}):Play()
		statusLabel.Text = "Status: ON"
		statusLabel.TextColor3 = Color3.fromRGB(46, 204, 113)
		
		-- ใส่โค้ดทำงานตอน ON ตรงนี้
		print("Feature Enabled!")
	else
		TweenService:Create(dot, tweenInfo, {Position = UDim2.new(0, 3, 0.5, -10)}):Play()
		TweenService:Create(switchBtn, tweenInfo, {BackgroundColor3 = Color3.fromRGB(60, 60, 70)}):Play()
		statusLabel.Text = "Status: OFF"
		statusLabel.TextColor3 = Color3.fromRGB(150, 150, 160)
		
		-- ใส่โค้ดทำงานตอน OFF ตรงนี้
		print("Feature Disabled!")
	end
end)

-- Function: ซ่อน/แสดง UI หน้าต่างหลัก
