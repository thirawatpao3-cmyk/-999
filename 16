local function getSongName(songId, callback)
    local numericId = tonumber(songId)
    if not numericId then
        callback("Unknown Song")
        return
    end
    task.spawn(function()
        local success, info = pcall(function()
            return MarketplaceService:GetProductInfo(numericId)
        end)
        if success and info and info.Name then
            callback(info.Name)
        else
            callback("ID: " .. songId)
        end
    end)
end

