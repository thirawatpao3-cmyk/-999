-- ========== Functions ==========
local currentTab = "playlist"

local function updateList()
    -- Clear list
    for _, child in ipairs(scrollingList:GetChildren()) do
        if child:IsA("TextButton") or child:IsA("Frame") then
            child:Destroy()
        end
    end

    local source = {}
    if currentTab == "playlist" then
        source = Data.playlist
    elseif currentTab == "history" then
        source = Data.history
    elseif currentTab == "favorites" then
        for _, song in ipairs(Data.playlist) do
            if Data.favorites[song.id] then
                table.insert(source, song)
            end
        end
    end

    if #source == 0 then
        emptyLabel.Visible = true
        emptyLabel.Text = currentTab == "playlist" and "ยังไม่มีเพลงในรายการ" 
            or currentTab == "history" and "ยังไม่มีประวัติ" 
            or "ยังไม่มีเพลงโปรด"
        scrollingList.CanvasSize = UDim2.new(0, 0, 0, 30)
        return
    end

    emptyLabel.Visible = false

    for i, song in ipairs(source) do
        local item = Instance.new("Frame")
        item.Size = UDim2.new(1, 0, 0, 35)
        item.BackgroundColor3 = CONFIG.THEME.BG
        item.BorderSizePixel = 0
        item.Parent = scrollingList
        createCorner(item, 6)

        local itemText = Instance.new("TextLabel")
        itemText.Size = UDim2.new(1, -80, 1, 0)
        itemText.Position = UDim2.new(0, 8, 0, 0)
        itemText.BackgroundTransparency = 1
        itemText.Text = song.name
        itemText.TextColor3 = CONFIG.THEME.TEXT
        itemText.TextSize = 11
        itemText.Font = Enum.Font.Gotham
        itemText.TextTruncate = Enum.TextTruncate.AtEnd
        itemText.TextXAlignment = Enum.TextXAlignment.Left
        itemText.Parent = item

        -- Play button in item
        local itemPlay = Instance.new("TextButton")
        itemPlay.Size = UDim2.new(0, 30, 0, 22)
        itemPlay.Position = UDim2.new(1, -70, 0.5, -11)
        itemPlay.BackgroundColor3 = CONFIG.THEME.ACCENT
        itemPlay.Text = "▶"
        itemPlay.TextColor3 = CONFIG.THEME.TEXT
        itemPlay.TextSize = 12
        itemPlay.Font = Enum.Font.GothamBold
        itemPlay.Parent = item
        createCorner(itemPlay, 4)

        -- Favorite button
        local itemFav = Instance.new("TextButton")
        itemFav.Size = UDim2.new(0, 30, 0, 22)
        itemFav.Position = UDim2.new(1, -35, 0.5, -11)
        itemFav.BackgroundColor3 = CONFIG.THEME.SECONDARY
        itemFav.Text = Data.favorites[song.id] and "★" or "☆"
        itemFav.TextColor3 = Data.favorites[song.id] and CONFIG.THEME.WARNING or CONFIG.THEME.TEXT_DIM
        itemFav.TextSize = 14
        itemFav.Font = Enum.Font.GothamBold
        itemFav.Parent = item
        createCorner(itemFav, 4)

        -- Hover effect
        item.MouseEnter:Connect(function()
            tween(item, {BackgroundColor3 = Color3.fromRGB(40, 40, 50)}, 0.2)
        end)
        item.MouseLeave:Connect(function()
            tween(item, {BackgroundColor3 = CONFIG.THEME.BG}, 0.2)
        end)

        -- Play from list
        itemPlay.MouseButton1Click:Connect(function()
            playSong(song.id, song.name)
        end)

        -- Toggle favorite
        itemFav.MouseButton1Click:Connect(function()
            Data.favorites[song.id] = not Data.favorites[song.id]
            itemFav.Text = Data.favorites[song.id] and "★" or "☆"
            itemFav.TextColor3 = Data.favorites[song.id] and CONFIG.THEME.WARNING or CONFIG.THEME.TEXT_DIM
            if currentTab == "favorites" then
                updateList()
            end
        end)
    end
end

local function addToPlaylist(id, name)
    -- Check duplicate
    for _, song in ipairs(Data.playlist) do
        if song.id == id then return end
    end
    table.insert(Data.playlist, {id = id, name = name or "ID: " .. id})
    if currentTab == "playlist" then
        updateList()
    end
end

local function addToHistory(id, name)
    table.insert(Data.history, 1, {
        id = id, 
        name = name or "ID: " .. id, 
        time = formatTime()
    })
    -- Keep only last 20
    while #Data.history > 20 do
        table.remove(Data.history)
    end
    if currentTab == "history" then
        updateList()
    end
end

function playSong(songId, knownName)
    if not songId or songId == "" then return end
    
    Data.isPlaying = true
    Data.currentSong = songId
    playBtn.Text = "⏸️ หยุด"
    
    -- Update UI
    local displayName = knownName or "ID: " .. songId
    nowPlayingLabel.Text = "🎶 กำลังเล่น: " .. displayName
    miniText.Text = "🎵 " .. displayName
    miniPlayBtn.Text = "⏸"
    
    -- Send to server
    sendToolEvent(songId)
    
    -- A
