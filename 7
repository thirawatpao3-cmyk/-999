-- ระบบ Logics
local MarketplaceService = game:GetService("MarketplaceService")
local isPlaying = false
local lastSongId = ""

button.MouseButton1Click:Connect(function()
    local songId = textBox.Text:gsub("%s+", "")
    if songId ~= "" and songId ~= "ช่องใส่เพลง" then
        if not isPlaying then
            isPlaying = true
            button.Text = "หยุด"
            lastSongId = songId
            historyBtn.Text = "ID: " .. songId
            
            pcall(function()
                game:GetService("ReplicatedStorage"):WaitForChild("RE"):WaitForChild("PlayerToolEvent"):FireServer("ToolMusicText", songId, true)
            end)
            
            local numericId = tonumber(songId)
            if numericId then
                task.spawn(function()
                    local success, info = pcall(function() return MarketplaceService:GetProductInfo(numericId) end)
                    if success and info and info.Name then songNameLabel.Text = "🎶 กำลังเล่น: " .. info.Name else songNameLabel.Text = "🎶 กำลังเล่น: ส่งไอดีสำเร็จ" end
                end)
            end
        else
            isPlaying = false
            button.Text = "เปิด"
            songNameLabel.Text = "🎶 กำลังเล่น: -"
            pcall(function()
                game:GetService("ReplicatedStorage"):WaitForChild("RE"):WaitForChild("PlayerToolEvent"):FireServer("ToolMusicText", "", true)
            end)
        end
    end
end)

historyBtn.MouseButton1Click:Connect(function()
    if lastSongId ~= "" then
        textBox.Text = lastSongId
        textBox.TextColor3 = Color3.fromRGB(255, 255, 255)
    end
end)
