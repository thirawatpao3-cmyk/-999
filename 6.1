-- ระบบขอบวิบวับ ขาว-ดำ แบบช้าๆ
task.spawn(function()
    while screenGui and screenGui.Parent do
        for i = 0, 1, 0.05 do
            if not screenGui or not screenGui.Parent then break end
            stroke.Color = Color3.fromRGB(255, 255, 255):Lerp(Color3.fromRGB(0, 0, 0), i)
            toggleBtn.BackgroundColor3 = stroke.Color
            task.wait(0.05)
        end
        for i = 0, 1, 0.05 do
            if not screenGui or not screenGui.Parent then break end
            stroke.Color = Color3.fromRGB(0, 0, 0):Lerp(Color3.fromRGB(255, 255, 255), i)
            toggleBtn.BackgroundColor3 = stroke.Color
            task.wait(0.05)
        end
    end
end)

local isOpen = true
toggleBtn.MouseButton1Click:Connect(function()
    isOpen = not isOpen
    frame.Visible = isOpen
end)

toggleBtn.MouseButton2Click:Connect(function()
    screenGui:Destroy()
end)

-- ระบบกด เปิด / หยุด เพลงสลับกัน พร้อมช่องใส่ไอดี
local MarketplaceService = game:GetService("MarketplaceService")
local isPlaying = false
local lastSongId = ""

button.MouseButton1Click:Connect(function()
    local songId = textBox.Text:gsub("%s+", "")
    
    if songId ~= "" and songId ~= "ช่องใส่เพลง" then
        if not isPlaying then
            -- สถานะ: กดเปิด
            isPlaying = true
            button.Text = "หยุด"
            lastSongId = songId
            
            -- อัปเดตปุ่มประวัติ
            historyBtn.Text = "ID: " .. songId
            
            local numericId = tonumber(songId)
            
            -- ส่ง RemoteEvent ไปเล่นเพลง
            local args = {
                "ToolMusicText",
                songId,
                [4] = true
            }
            pcall(function()
                game:GetService("ReplicatedStorage"):WaitForChild("RE"):WaitForChild("PlayerToolEvent"):FireServer(unpack(args))
            end)
            
            -- ดึงชื่อเพลงมาแสดงผล
            if numericId then
                task.spawn(function()
                    local success, info = pcall(function()
                        return MarketplaceService:GetProductInfo(numericId)
                    end)
                    if success and info and info.Name then
                        songNameLabel.Text = "🎶 กำลังเล่น: " .. info.Name
                    else
                        songNameLabel.Text = "🎶 กำลังเล่น: (ไม่พบชื่อเพลง)"
                    end
                end)
            else
                songNameLabel.Text = "🎶 กำลังเล่น: ส่งไอดีสำเร็จ"
            end
        else
            -- สถานะ: กดหยุด
            isPlaying = false
            button.Text = "เปิด"
            songNameLabel.Text = "🎶 กำลังเล่น: -"
            
            -- ส่งค่าเคลียร์เพลง
            local args = {
                "ToolMusicText",
                "",
                [4] = true
            }
            pcall(function()
                game:GetService("ReplicatedStorage"):WaitForChild("RE"):WaitForChild("PlayerToolEvent"):FireServer(unpack(args))
            end)
        end
    end
end)

-- กดที่ปุ่มประวัติเพื่อดึงไอดีกลับมาใส่ช่องกรอก
historyBtn.MouseButton1Click:Connect(function()
    if lastSongId ~= "" then
        textBox.Text = lastSongId
        textBox.TextColor3 = Color3.fromRGB(255, 255, 255)
    end
end)

-- [เพิ่มใหม่] ระบบปุ่มล้างค่าประวัติ
resetHistoryBtn.MouseButton1Click:Connect(function()
    lastSongId = ""
    historyBtn.Text = "ยังไม่มีประวัติเพลง"
end)

print("Custom Music UI Pro Loaded Successfully with Reset Feature!")
