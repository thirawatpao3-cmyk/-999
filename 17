local function getId(soundId)
    return tostring(soundId):match("%d+")
end

local scannedSounds = {}

local function clear()
    for _, child in ipairs(list:GetChildren()) do
        if child:IsA("TextButton") or child:IsA("TextLabel") then
            child:Destroy()
        end
    end
end

local function addSoundEntry(name, id)
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1, -10, 0, 55)
    button.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
    button.TextColor3 = Color3.new(1, 1, 1)
    button.TextSize = 14
    button.Font = Enum.Font.Gotham
    button.TextWrapped = true
    button.Text = name .. "\nID: " .. tostring(id)
    button.Parent = list

    Instance.new("UICorner", button).CornerRadius = UDim.new(0, 7)

    button.MouseButton1Click:Connect(function()
        if id and setclipboard then
            setclipboard(id)
            button.Text = name .. "\nคัดลอก ID แล้ว: " .. id
            task.delay(1.5, function()
                if button.Parent then
                    button.Text = name .. "\nID: " .. id
                end
            end)
        end
    end)
end

local function filterSounds(query)
    query = query:lower()
    for _, child in ipairs(list:GetChildren()) do
        if child:IsA("TextButton") then
            local text = child.Text:lower()
            if query == "" or text:find(query) then
                child.Visible = true
            else
                child.Visible = false
            end
        end
    end
end

local function scanSounds()
    clear()
    scannedSounds = {}
    local count = 0

    local containers = {workspace, SoundService, ReplicatedStorage}

    for _, container in ipairs(containers) do
        for _, obj in ipairs(container:GetDescendants()) do
            if obj:IsA("Sound") and obj.SoundId ~= "" then
                local id = getId(obj.SoundId)
                if id and not scannedSounds[id] then
                    scannedSounds[id] = true
                    count += 1
                    addSoundEntry(obj.Name, id)
                end
            end
        end
    end

    list.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y)

    if count == 0 then
        local empty = Instance.new("TextLabel")
        empty.Size = UDim2.new(1, -10, 0, 40)
        empty.BackgroundTransparency = 1
        empty.Text = "ไม่พบ Sound ในเกม"
        empty.TextColor3 = Color3.new(1, 1, 1)
        empty.TextSize = 16
        empty.Parent = list
    end
    
    filterSounds(searchBox.Text)
end

scan.MouseButton1Click:Connect(scanSounds)
searchBox:GetPropertyChangedSignal("Text"):Connect(function()
    filterSounds(searchBox.Text)
end)

layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
    list.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 10)
end)

-- ดักจับเสียงที่เพิ่มเข้ามาใหม่แบบ Real-time
local function onDescendantAdded(obj)
    if obj:IsA("Sound") and obj.SoundId ~= "" then
        local id = getId(obj.SoundId)
        if id and not scannedSounds[id] then
            scannedSounds[id] = true
            addSoundEntry(obj.Name, id)
        end
    end
end

workspace.DescendantAdded:Connect(onDescendantAdded)
SoundService.DescendantAdded:Connect(onDescendantAdded)
ReplicatedStorage.DescendantAdded:Connect(onDescendantAdded)

scanSounds()
